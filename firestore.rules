rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} { allow create: if ownUser(uid); allow read, update: if ownUser(uid); allow delete: if false;
      match /devices/{deviceId} { allow read, write: if ownUser(uid); }
    }
    match /directConversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.resource.data.participantIds.size() == 2 && request.resource.data.participantIds[0] < request.resource.data.participantIds[1] && request.auth.uid in request.resource.data.participantIds && id == 'direct_' + request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1] && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0])) && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]));
      allow update, delete: if false;
    }
    match /groups/{groupId} { allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerId && request.auth.uid in request.resource.data.memberIds && request.resource.data.memberIds.size() >= 2 && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size() && request.resource.data.memberLimit is int && request.resource.data.memberIds.size() <= request.resource.data.memberLimit && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.notificationPolicy in ['all_group_messages','mentioned_members','direct_messages_only','disabled'];
      allow update, delete: if false;
    }
    match /notificationDeliveries/{id} { allow read, write: if false; }
  }
}
